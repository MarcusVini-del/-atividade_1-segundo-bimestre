programa
{
	
	funcao inicio()
	{
	real dobro_area_maraca
	real comprimento_maraca
	real largura_maraca
	
	escreva("qual seria o valor do comprimento e largura do maracanã?",  "\n")
	escreva("informe primeiro a largura: ")
	leia(largura_maraca)
	escreva("depois informe o comprimento: ")
	leia(comprimento_maraca)

	dobro_area_maraca = (largura_maraca * comprimento_maraca) * 2

	escreva("O dobro da área do Maracanã é ", dobro_area_maraca, " metros quadrados")
	}
}
