programa
{
	
	funcao inicio()
	{ 
	real nota1, nota2, nota3, nota4
	
	escreva("diga as suas notas durante os 4 bimestres: ")
	leia(nota1, nota2, nota3, nota4)
	
	escreva((nota1 + nota2 + nota3 + nota4) / 4 , "\n")
	escreva("Essa é a sua média.")
	}
}
