programa
{
	
	funcao inicio()
	{
	cadeia mae = "Tess"
	cadeia filha = "Anna"
	cadeia FilhaMae
	cadeia MaeFilha = "Tess"

	FilhaMae = mae
	mae = filha

	escreva ("A ", FilhaMae , " virou a ", mae , " e a ", mae , " virou a ", MaeFilha)
	}
}
