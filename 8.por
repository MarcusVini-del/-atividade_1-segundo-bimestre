programa
{
	
	funcao inicio()
	{
	cadeia mae = "Tess"
	cadeia filha = "Anna"
	cadeia auxMae = "Tess"

	auxMae = filha
	filha = mae
	mae = auxFilha
	

	escreva ("A ", filha , " virou a ", mae , " e a ", auxFilha , " virou a ", filha)
	}
}
