programa
{
	
	funcao inicio()
	{
	inteiro metro
	
	escreva("diga a quantia de metros que vocẽ quer converter para centímetros ")
	leia(metro)

	escreva("O seu valor em centímetros é : ", metro * 100)
	}
}
